# OpenRouter（文案生成，只用免费模型）
# 从 https://openrouter.ai 创建 Key，不要把真实 Key 提交进仓库
OPENROUTER_API_KEY=
# 可选。运行时仍以免费文本模型目录为准；若该 id 当时仍免费且可用，则优先选用
OPENROUTER_PREFERRED_MODEL=liquid/lfm-3-1.7b:free

# 本地 CLI 没有 Workers AI 绑定，保持 mock。
# 线上工作台在 wrangler.toml 里使用 workers_ai。
# 可选值：mock | workers_ai | openai_compatible
IMAGE_PROVIDER=mock

# 仅 IMAGE_PROVIDER=openai_compatible 时使用。不要填 Seedance 或 Grok / xAI。
# IMAGE_GEN_BASE_URL=https://example.invalid/v1
# IMAGE_GEN_API_KEY=
# IMAGE_GEN_MODEL=
# IMAGE_GEN_PATH=/images/generations

# 可选：本地数据目录（默认使用项目下的 data/）
# WOWACOOL_DATA_DIR=

# Worker 密钥（不要写进仓库，用 npx wrangler secret put 设置）：
# OPENROUTER_API_KEY
# APP_ACCESS_TOKEN   可选。不设置时运营页公开可开，便于部署后演示。
